# Development/demo: copy this file to .env.local. Restart Vite after changes.
VITE_API_BASE_URL=/api/v1
VITE_DEMO_MODE=true
# Vite dev proxy target is server-side (not exposed to the browser).
DEV_API_TARGET=http://localhost:8088
# Docker-only upstream. Backend container must have this alias on my-shared-network.
BACKEND_URL=http://organic-backend:8088
FRONTEND_PORT=3000
