# Development/demo: copy this file to .env.local. Restart Vite after changes.
VITE_API_BASE_URL=/api/v1
VITE_ADDRESS_BOUNDARY_BASE_URL=https://tinhthanhpho.com/data
VITE_DEMO_MODE=true
# Vite dev proxy target is server-side (not exposed to the browser).
DEV_API_TARGET=http://localhost:8088
# Checkout uses backend-hosted payment redirects; no Stripe/PayPal secret belongs here.
# Backend allowed origins and payment return URLs must match this frontend's actual URL.
# Docker-only upstream. Backend container must have this alias on my-shared-network.
BACKEND_URL=http://organic-backend:8088
FRONTEND_PORT=3000
# Public web push key. Defaults for backend-organic are included in src/constants/firebase.js.
# Firebase Analytics is not initialized; only Messaging is used.
VITE_FIREBASE_VAPID_KEY=BOBEc_gfBydu6Y_cGqlkGTLAD5sdgkKtaYziwwkIxtlczhv8rFZIKDx-_HqS_J2qJHVaGhBku65NJqPoav3aBno
# Optional project overrides (all are public web config, never service-account JSON).
VITE_FIREBASE_API_KEY=REMOVED_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=backend-organic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=backend-organic
VITE_FIREBASE_STORAGE_BUCKET=backend-organic.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=100870302988
VITE_FIREBASE_APP_ID=1:100870302988:web:b394eb465b403b7ffa6d29
VITE_FIREBASE_MEASUREMENT_ID=G-LK2FEW3YFV
